{
  "about": "Saving into config.json (ConfigPatch.apply / Apply, setLevels / SetLevels, hasComments / HasComments). `out` is the saved file as JSON, or {\"error\": true}.",
  "cases": [
    {"name": "a level is added for a monitor with no entry", "fn": "setLevels", "in": {"original": null, "display": "Dell AW3821DW", "suggestedMatch": "AW3821DW", "levels": {"day": 60}}, "out": {"monitors": [{"match": "AW3821DW", "day": 60}]}},
    {"name": "an existing entry is updated and keeps its other keys", "fn": "setLevels", "in": {"original": "{\"custom\": 1, \"monitors\": [{\"match\": \"aw3821\", \"label\": \"Left\", \"contrast\": 50, \"night\": 20}]}", "display": "Dell AW3821DW", "suggestedMatch": "AW3821DW", "levels": {"night": 25, "nightLights": 35}}, "out": {"custom": 1, "monitors": [{"match": "aw3821", "label": "Left", "contrast": 50, "night": 25, "nightLights": 35}]}},
    {"name": "a level above 100 is saved as 100", "fn": "setLevels", "in": {"original": null, "display": "Dell AW3821DW", "suggestedMatch": "AW3821DW", "levels": {"night": 150}}, "out": {"monitors": [{"match": "AW3821DW", "night": 100}]}},
    {"name": "a key that is not a level is ignored", "fn": "setLevels", "in": {"original": null, "display": "Dell AW3821DW", "suggestedMatch": "AW3821DW", "levels": {"day": 60, "contrast": 10}}, "out": {"monitors": [{"match": "AW3821DW", "day": 60}]}},
    {"name": "decimals elsewhere in the file are kept as written", "fn": "setLevels", "in": {"original": "{\"location\": {\"latitude\": 10.12, \"longitude\": 20.5}}", "display": "Dell AW3821DW", "suggestedMatch": "AW3821DW", "levels": {"day": 60}}, "out": {"location": {"latitude": 10.12, "longitude": 20.5}, "monitors": [{"match": "AW3821DW", "day": 60}]}},
    {"name": "a file that is not an object is not touched", "fn": "setLevels", "in": {"original": "[1]", "display": "Dell AW3821DW", "suggestedMatch": "AW3821DW", "levels": {"day": 60}}, "out": {"error": true}},
    {"name": "monitors that are not a list are not touched", "fn": "setLevels", "in": {"original": "{\"monitors\": {}}", "display": "Dell AW3821DW", "suggestedMatch": "AW3821DW", "levels": {"day": 60}}, "out": {"error": true}},
    {"name": "two monitors of the same model with no entry yet: the first one's levels are saved", "fn": "apply", "in": {"original": null, "edit": {"source": "off", "latitude": null, "longitude": null, "monitors": [{"name": "Dell U2720Q", "suggestedMatch": "U2720Q", "label": "Dell U2720Q", "day": 80, "blindDown": 40, "night": 20}, {"name": "Dell U2720Q", "suggestedMatch": "U2720Q", "label": "Dell U2720Q", "day": 10, "blindDown": 40, "night": 20}], "haURL": "", "autoSwitch": "", "sun": "", "cover": "", "lights": ""}}, "out": {"source": "off", "monitors": [{"match": "U2720Q", "day": 80, "blindDown": 40, "night": 20}]}},
    {"name": "two monitors of the same model with an entry: the first one's levels are saved", "fn": "apply", "in": {"original": "{\"monitors\": [{\"match\": \"U2720Q\", \"day\": 50}]}", "edit": {"source": "off", "latitude": null, "longitude": null, "monitors": [{"name": "Dell U2720Q", "suggestedMatch": "U2720Q", "label": "Dell U2720Q", "day": 80, "blindDown": 40, "night": 20}, {"name": "Dell U2720Q", "suggestedMatch": "U2720Q", "label": "Dell U2720Q", "day": 10, "blindDown": 40, "night": 20}], "haURL": "", "autoSwitch": "", "sun": "", "cover": "", "lights": ""}}, "out": {"source": "off", "monitors": [{"match": "U2720Q", "day": 80, "blindDown": 40, "night": 20}]}},
    {"name": "a location is saved with two decimals, halves away from zero", "fn": "apply", "in": {"original": null, "edit": {"source": "sun", "latitude": 10.125, "longitude": 20.335, "monitors": [], "haURL": "", "autoSwitch": "", "sun": "", "cover": "", "lights": ""}}, "out": {"source": "sun", "location": {"latitude": 10.13, "longitude": 20.34}}},
    {"name": "keys the window does not own are kept", "fn": "apply", "in": {"original": "{\"custom\": 1, \"monitors\": [{\"match\": \"U2720Q\", \"control\": \"ddc\", \"day\": 50}]}", "edit": {"source": "off", "latitude": null, "longitude": null, "monitors": [{"name": "Dell U2720Q", "suggestedMatch": "U2720Q", "label": "Dell U2720Q", "day": 60, "blindDown": 40, "night": 20}], "haURL": "", "autoSwitch": "", "sun": "", "cover": "", "lights": ""}}, "out": {"source": "off", "custom": 1, "monitors": [{"match": "U2720Q", "control": "ddc", "day": 60, "blindDown": 40, "night": 20}]}},
    {"name": "a label equal to the display name is not saved", "fn": "apply", "in": {"original": null, "edit": {"source": "off", "latitude": null, "longitude": null, "monitors": [{"name": "Dell U2720Q", "suggestedMatch": "U2720Q", "label": "Dell U2720Q", "day": 60, "blindDown": 40, "night": 20}], "haURL": "", "autoSwitch": "", "sun": "", "cover": "", "lights": ""}}, "out": {"source": "off", "monitors": [{"match": "U2720Q", "day": 60, "blindDown": 40, "night": 20}]}},
    {"name": "Home Assistant mode without an address still makes a file that loads (the Settings window asks for one first)", "fn": "apply", "in": {"original": null, "edit": {"source": "homeAssistant", "latitude": null, "longitude": null, "monitors": [], "haURL": "", "autoSwitch": "", "sun": "", "cover": "", "lights": ""}}, "out": {"source": "homeAssistant"}},
    {"name": "an address that is not http is not saved", "fn": "apply", "in": {"original": null, "edit": {"source": "homeAssistant", "latitude": null, "longitude": null, "monitors": [], "haURL": "ftp://ha.example", "autoSwitch": "", "sun": "", "cover": "", "lights": ""}}, "out": {"error": true}},
    {"name": "no comments", "fn": "hasComments", "in": {"text": "{\"a\": \"http://x\"}"}, "out": false},
    {"name": "a line comment", "fn": "hasComments", "in": {"text": "{ // c\n}"}, "out": true},
    {"name": "a block comment", "fn": "hasComments", "in": {"text": "/* x */ {}"}, "out": true},
    {"name": "comment marks after an escaped quote inside a string are text", "fn": "hasComments", "in": {"text": "{\"a\": \"\\\"//\"}"}, "out": false}
  ]
}
