{
  "about": "The brightness target and the small rules around it (Rules on both apps), with default tuning: night at -3° and below, full day from 12°, the lights boost of 5 below 1.5°.",
  "cases": [
    {"name": "full sun, blind open: the day level", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 12, "pos": 100, "lights": false}, "out": 70},
    {"name": "sun down: the night level", "fn": "target", "in": {"levels": [70, 40, 20], "elev": -3, "pos": 100, "lights": false}, "out": 20},
    {"name": "halfway up: halfway between night and day", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 4.5, "pos": 100, "lights": false}, "out": 45},
    {"name": "blind closed in full sun: the blind-down level", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 12, "pos": 0, "lights": false}, "out": 40},
    {"name": "blind half down in full sun", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 12, "pos": 50, "lights": false}, "out": 55},
    {"name": "lights on at night add the boost", "fn": "target", "in": {"levels": [70, 40, 20], "elev": -10, "pos": 100, "lights": true}, "out": 25},
    {"name": "lights on with the sun at 4.5° add nothing", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 4.5, "pos": 100, "lights": true}, "out": 45},
    {"name": "lights on just above the horizon: the blend already beats the boost", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 0, "pos": 100, "lights": true}, "out": 30},
    {"name": "a cloudy sky caps daylight", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 12, "pos": 100, "lights": false, "light": 0.5}, "out": 45},
    {"name": "a light cap that is not a number caps nothing", "fn": "target", "in": {"levels": [70, 40, 20], "elev": 12, "pos": 100, "lights": false, "light": "NaN"}, "out": 70},
    {"name": "an elevation that is not a number gives the night level", "fn": "target", "in": {"levels": [70, 40, 20], "elev": "NaN", "pos": 100, "lights": false}, "out": 20},
    {"name": "night lights level with the lights on after sunset", "fn": "target", "in": {"levels": [70, 40, 20, 40], "elev": -10, "pos": 100, "lights": true}, "out": 40},
    {"name": "night lights level with the lights off after sunset", "fn": "target", "in": {"levels": [70, 40, 20, 40], "elev": -10, "pos": 100, "lights": false}, "out": 20},
    {"name": "night lights level changes nothing in full sun", "fn": "target", "in": {"levels": [70, 40, 20, 40], "elev": 12, "pos": 100, "lights": true}, "out": 70},
    {"name": "levels out of range are clamped", "fn": "target", "in": {"levels": [150, 40, -5], "elev": 12, "pos": 100, "lights": false}, "out": 100},
    {"name": "a half rounds up", "fn": "target", "in": {"levels": [71, 40, 20], "elev": 4.5, "pos": 100, "lights": false}, "out": 46},
    {"name": "a blind with no position, never seen, is open", "fn": "blindPosition", "in": {"reported": -1, "last": null}, "out": 100},
    {"name": "a blind with no position keeps its last one", "fn": "blindPosition", "in": {"reported": -1, "last": 30}, "out": 30},
    {"name": "a blind above 100 is open", "fn": "blindPosition", "in": {"reported": 150, "last": null}, "out": 100},
    {"name": "a level that is not a number is 0", "fn": "clampLevel", "in": {"v": "NaN"}, "out": 0},
    {"name": "an infinite level is 100", "fn": "clampLevel", "in": {"v": "Infinity"}, "out": 100},
    {"name": "a negative level is 0", "fn": "clampLevel", "in": {"v": -5}, "out": 0},
    {"name": "a level with decimals is kept", "fn": "clampLevel", "in": {"v": 50.5}, "out": 50.5},
    {"name": "HA's switch decides when it gives a value", "fn": "automaticNow", "in": {"hasSwitch": true, "fromHA": false, "lastFromHA": true, "local": true}, "out": false},
    {"name": "a switch HA gives no value for keeps the last one", "fn": "automaticNow", "in": {"hasSwitch": true, "fromHA": null, "lastFromHA": false, "local": true}, "out": false},
    {"name": "a switch never seen falls back to the local setting", "fn": "automaticNow", "in": {"hasSwitch": true, "fromHA": null, "lastFromHA": null, "local": true}, "out": true},
    {"name": "no switch: the local setting", "fn": "automaticNow", "in": {"hasSwitch": false, "fromHA": null, "lastFromHA": true, "local": false}, "out": false},
    {"name": "an outage with a switch keeps HA's last state", "fn": "automaticFallback", "in": {"hasSwitch": true, "lastFromHA": false, "local": true}, "out": false},
    {"name": "an outage without a switch uses the local setting", "fn": "automaticFallback", "in": {"hasSwitch": false, "lastFromHA": false, "local": true}, "out": true},
