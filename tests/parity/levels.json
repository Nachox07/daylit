    {"name": "a saved switch state does not count for another entity", "fn": "storedAutomatic", "in": {"value": true, "entity": "input_boolean.a", "configured": "input_boolean.b"}, "out": null},
    {"name": "a saved switch state with no entity recorded does not count", "fn": "storedAutomatic", "in": {"value": true, "entity": null, "configured": "input_boolean.a"}, "out": null},
    {"name": "no switch configured: nothing saved counts", "fn": "storedAutomatic", "in": {"value": true, "entity": "", "configured": ""}, "out": null},
    {"name": "HA's lights while it answers", "fn": "roomLights", "in": {"reported": true, "fromHA": true, "last": null, "hasNightLights": false}, "out": true},
    {"name": "an outage keeps the lights for a night-lights monitor", "fn": "roomLights", "in": {"reported": false, "fromHA": false, "last": true, "hasNightLights": true}, "out": true},
    {"name": "an outage counts the lights off for other monitors", "fn": "roomLights", "in": {"reported": true, "fromHA": false, "last": true, "hasNightLights": false}, "out": false},
    {"name": "a daytime offset in full sun applies fully", "fn": "offsetWeight", "in": {"sun": 1, "setAt": 1, "age": null}, "out": 1},
    {"name": "a daytime offset fades at dusk", "fn": "offsetWeight", "in": {"sun": 0.15, "setAt": 1, "age": null}, "out": 0.5},
    {"name": "a young daytime offset fades no faster than half an hour", "fn": "offsetWeight", "in": {"sun": 0.15, "setAt": 1, "age": 600}, "out": 0.6666666666666667},
    {"name": "an offset set in weak light fades from where it was set", "fn": "offsetWeight", "in": {"sun": 0.15, "setAt": 0.2, "age": null}, "out": 0.75},
    {"name": "a night offset applies fully at night", "fn": "offsetWeight", "in": {"sun": 0, "setAt": 0, "age": null}, "out": 1},
    {"name": "a night offset fades as the sun comes up", "fn": "offsetWeight", "in": {"sun": 0.15, "setAt": 0, "age": null}, "out": 0.5},
    {"name": "a night offset is over at the fade edge", "fn": "offsetWeight", "in": {"sun": 0.3, "setAt": 0, "age": null}, "out": null},
    {"name": "an unchanged level is not the user's", "fn": "userLevelWins", "in": {"atRead": 50, "now": 50, "held": false}, "out": false},
    {"name": "a level moved during the wait is the user's", "fn": "userLevelWins", "in": {"atRead": 50, "now": 60, "held": false}, "out": true},
    {"name": "a held slider is the user's", "fn": "userLevelWins", "in": {"atRead": 50, "now": 50, "held": true}, "out": true},
    {"name": "no level: nothing to win", "fn": "userLevelWins", "in": {"atRead": 50, "now": null, "held": true}, "out": false},
    {"name": "decide on the user's newer level", "fn": "levelToDecideOn", "in": {"read": 40, "atRead": 50, "model": 60, "held": false}, "out": 60},
    {"name": "decide on the reading otherwise", "fn": "levelToDecideOn", "in": {"read": 40, "atRead": 50, "model": 50, "held": false}, "out": 40},
    {"name": "a good write moves the slider", "fn": "levelAfterWrite", "in": {"new": 70, "ok": true, "atStart": 50, "now": 50, "held": false}, "out": 70},
    {"name": "a refused write leaves the slider", "fn": "levelAfterWrite", "in": {"new": 70, "ok": false, "atStart": 50, "now": 50, "held": false}, "out": null},
    {"name": "a level the user set during the write wins", "fn": "levelAfterWrite", "in": {"new": 70, "ok": true, "atStart": 50, "now": 55, "held": false}, "out": null}
  ]
}
