{
  "source": "homeAssistant",
  "location": { "latitude": 51.5, "longitude": -0.12 },
  "pauseOnBattery": true,
  "homeAssistant": {
    "url": "http://homeassistant.local:8123",
    "tokenName": "daylit-home-assistant",
    "autoSwitch": "input_boolean.daylit_auto",
    "sun": "sun.sun",
    "cover": "cover.study_blind",
    "lights": "light.study",
    "light": "sensor.solar_power"
  },
  "monitors": [
    {
      "match": "U2723QE",
      "label": "Left monitor",
      "control": "ddc",
      "day": 70, "blindDown": 40, "night": 20,
      "homeAssistant": {
        "sensor": "sensor.daylit_left_monitor",
        "day": "input_number.daylit_left_day",
        "blindDown": "input_number.daylit_left_blind_down",
        "night": "input_number.daylit_left_night",
        "set": "input_number.daylit_left_set"
      }
    },
    {
      "match": "LG HDR 4K",
      "label": "Right monitor",
      "control": "native",
      "day": 90, "blindDown": 60, "night": 30
    }
  ],
  "tuning": {
    "brightness": { "sunNight": -3, "sunDay": 12, "lightsBoost": 5, "lightsBoostSunBelow": 1.5 },
    "theme": { "lightSunAbove": 4, "darkSunBelow": 1, "lightBlindAbove": 55, "darkBlindBelow": 35,
               "whiteLightsAbove": 78.4, "whiteLightsBelow": 66.6, "whiteSaturationMax": 35, "warmSaturationMin": 45,
               "room": true },
    "timing": { "pollSeconds": 30, "batteryPollSeconds": 120, "idleSeconds": 300,
                "haFallbackSeconds": 60, "manualKeepHours": 12 }
  }
}
