# The style the code already has, so editors and agents keep it. Nothing is reformatted by this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{swift,cs,ps1,py}]
indent_size = 4

[*.{json,yml,yaml,sh,csproj,xml,manifest,rb}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Issue forms keep markdown text, where two trailing spaces can be a line break.
[.github/ISSUE_TEMPLATE/*.yml]
trim_trailing_whitespace = false

# C#: the layout the code already uses, so a later `dotnet format` keeps it. Braces on the same line;
# short members and blocks stay on one line. else / catch / finally are mixed today (most on the same
# line as the closing brace); new code follows the same-line form.
[*.cs]
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
